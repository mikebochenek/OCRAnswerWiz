<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Wizard Hat Cone -->
    <path
        android:pathData="M54,25C60,25 65,35 62,45C59,55 75,70 80,80L28,80C33,70 45,60 48,45C50,35 48,25 54,25Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="25"
                android:endX="54"
                android:endY="80"
                android:type="linear">
                <item android:offset="0" android:color="#7E57C2"/> <!-- Light Purple -->
                <item android:offset="1" android:color="#4527A0"/> <!-- Deep Purple -->
            </gradient>
        </aapt:attr>
    </path>

    <!-- Wizard Hat Brim -->
    <path
        android:pathData="M20,80Q54,92 88,80Q54,68 20,80Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="20"
                android:startY="80"
                android:endX="88"
                android:endY="80"
                android:type="linear">
                <item android:offset="0" android:color="#311B92"/>
                <item android:offset="0.5" android:color="#4527A0"/>
                <item android:offset="1" android:color="#311B92"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Golden Band -->
    <path
        android:pathData="M31,75Q54,80 77,75L79,80Q54,85 29,80Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="31"
                android:startY="75"
                android:endX="77"
                android:endY="75"
                android:type="linear">
                <item android:offset="0" android:color="#FFD600"/> <!-- Gold -->
                <item android:offset="0.5" android:color="#FFF176"/> <!-- Light Gold/Glow -->
                <item android:offset="1" android:color="#FFD600"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glowing Question Mark -->
    <path
        android:pathData="M54,10C59,10 63,14 63,18C63,22 59,24 56,26L56,29 M54,34L54,36"
        android:strokeWidth="3.5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="54"
                android:startY="10"
                android:endX="54"
                android:endY="36"
                android:type="linear">
                <item android:offset="0" android:color="#FFFF00"/> <!-- Vibrant Gold -->
                <item android:offset="1" android:color="#FFD600"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glow for Question Mark (Subtle) -->
    <path
        android:pathData="M54,10C59,10 63,14 63,18C63,22 59,24 56,26L56,29 M54,34L54,36"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeAlpha="0.3">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="54"
                android:startY="10"
                android:endX="54"
                android:endY="36"
                android:type="linear">
                <item android:offset="0" android:color="#FFFFFF"/>
                <item android:offset="1" android:color="#FFD600"/>
            </gradient>
        </aapt:attr>
    </path>

</vector>